# Local configuration. Copy to .env for development. The packaged app creates
# %APPDATA%\StockSync AI\.env (Electron userData). Process environment variables
# with the same names override .env values. Never commit real credentials.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_REQUEST_TIMEOUT_SECONDS=90
GEMINI_MAX_RETRIES=2

# POS SQL Server — Read-only connection
# Format: Server=YOUR_SERVER;Database=pos;User ID=stocksync_reader;Password=...;Encrypt=True;TrustServerCertificate=False;Application Intent=ReadOnly
STOCKSYNC_POS_CONNECTION_STRING=

# POS SQL Server — Separate least-privilege write connection
# Never reuse the read-only connection. Do not grant schema modification permissions.
STOCKSYNC_POS_WRITE_CONNECTION_STRING=

# Explicit verification of actual POS business conventions
STOCKSYNC_POS_BUSINESS_CONVENTIONS_VERIFIED=false

# Explicit authorization to allow POS writes
STOCKSYNC_POS_WRITES_ENABLED=false

# STOCKSYNC_BACKEND_PORT=0
# STOCKSYNC_DATA_DIR=C:\\Users\\you\\AppData\\Local\\StockSyncAI
# STOCKSYNC_INVOICE_MAX_BYTES=20971520
